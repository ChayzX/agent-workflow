# systemd *user* unit for the agent-VM egress allowlist proxy (installed by `orchestrator setup --service`;
# enabled when security.agentBackend is "devvm"). Guests reach the internet only through this proxy.
[Unit]
Description=Agent Workflow Orchestrator - allowlist egress proxy for agent VMs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=ORCH_HOME=@HOME@
Environment=PATH=@NODE_DIR@:/usr/local/bin:/usr/bin:/bin
ExecStart=@BIN@ egress-proxy
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
UMask=0077
MemoryMax=512M

[Install]
WantedBy=default.target
